// Esquema de datos de GASTOSACK.
// Todos los importes se guardan en céntimos (enteros).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Persona con acceso a la app. La cuenta de Supabase se vincula por email.
model Member {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @unique @db.Uuid // auth.users.id de Supabase
  email     String    @unique
  name      String
  isAdmin   Boolean   @default(false)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  emoji    String    @default("💸")
  position Int       @default(0)
  expenses Expense[]
}

model Expense {
  id          String    @id @default(uuid()) @db.Uuid
  amountCents Int
  date        DateTime  @db.Date
  description String
  categoryId  String?   @db.Uuid
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  memberId    String    @db.Uuid
  member      Member    @relation(fields: [memberId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([date])
}
