# ───────────── Supabase → Project Settings → Data API / API Keys ─────────────
# URL del proyecto (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_…). Antes se llamaba "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_…). Antes "service_role". ¡NUNCA en el navegador ni en git!
SUPABASE_SECRET_KEY=

# ───────────── Supabase → botón "Connect" (arriba) → ORMs / Connection string ─────────────
# Transaction pooler (puerto 6543). La usa la app en Vercel.
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (puerto 5432). La usan las migraciones y el seed.
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ───────────── Seed ─────────────
# Email de la cuenta que será administradora
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
