# ───────────── Supabase → Project Settings → API ─────────────
# URL del proyecto (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_…). Es pública por diseño: los datos los protege Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ───────────── Distancias (solo servidor, opcional) ─────────────
# Gratis y sin tarjeta: https://openrouteservice.org/dev → Sign up → API Key
OPENROUTESERVICE_API_KEY=

