# ───────────── Supabase → Project Settings → API ─────────────
# URL del proyecto (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_…). Es pública por diseño: los datos los protege Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ───────────── Distancias (solo servidor; basta con una) ─────────────
# Google Cloud → APIs → "Routes API"
GOOGLE_MAPS_API_KEY=
# Alternativa gratuita: https://openrouteservice.org/dev
OPENROUTESERVICE_API_KEY=

