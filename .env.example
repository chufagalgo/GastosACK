# ───────────── Supabase → Project Settings → API ─────────────
# URL del proyecto (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Clave "anon" (pública por diseño: todo pasa por Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ───────────── Distancias (solo servidor; basta con una) ─────────────
# Google Cloud → APIs → "Routes API"
GOOGLE_MAPS_API_KEY=
# Alternativa gratuita: https://openrouteservice.org/dev
OPENROUTESERVICE_API_KEY=

# ───────────── Lectura de tickets (fase 2, solo servidor) ─────────────
ANTHROPIC_API_KEY=
